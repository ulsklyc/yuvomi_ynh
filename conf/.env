# Managed by the YunoHost package. Manual edits are overwritten on upgrade:
# change settings with `yunohost app setting __APP__ <key> -v <value>` instead.
NODE_ENV=production
PORT=__PORT__
BIND_ADDRESS=127.0.0.1
BASE_URL=https://__DOMAIN__

SESSION_SECRET=__SESSION_SECRET__
SESSION_SECURE=true
TRUST_PROXY=loopback

# Losing this key makes the database unreadable. It is kept in the app settings
# and in every YunoHost backup of this app.
DB_ENCRYPTION_KEY=__DB_ENCRYPTION_KEY__
DB_PATH=__DATA_DIR__/db/yuvomi.db

BACKUP_DIR=__DATA_DIR__/backups
MODULES_DIR=__DATA_DIR__/modules
DOCUMENT_STORAGE_LOCAL_PATH=__DATA_DIR__/documents
